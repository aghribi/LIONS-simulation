# CC-IN2P3 (Lyon), group m4cast. Read by tools/site.sh on the laptop and by jobs/_job_env.sh in jobs.
SSH=ccin2p3
SCHED=slurm
CLONE=/pbs/throng/m4cast/projects/iris/cloned_repo/LIONS-simulation
CONTAINER=apptainer
CONTAINER_SETUP='export APPTAINER_CACHEDIR=/sps/m4cast/iRIS/.apptainer_cache'
IMAGE_DIR=/sps/m4cast/iRIS/images
XSH_RESULTS=/sps/m4cast/iRIS/_results/_results_ccin2p3
SLURM_OPTS_prod='--account=m4cast --partition=htc --qos=normal'
SLURM_OPTS_test='--account=m4cast --partition=flash --qos=flash'
SLURM_OPTS_gpu='--account=m4cast --partition=gpu_h100 --qos=gpu --gres=gpu:h100:1'
SLURM_OPTS_gpu_v100='--account=m4cast --partition=gpu_v100 --qos=gpu --gres=gpu:v100:1'
