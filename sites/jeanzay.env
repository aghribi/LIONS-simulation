# Jean-Zay (IDRIS), project iwy (103062). IDRIS sets memory from the cores: no --mem.
# Images run only from the IDRIS-approved directory; tools/site.sh setup copies them there with idrcontmgr.
# WORK file quota is shared by the group (97 % of inodes used, 2026-10-31): jobs write few, large files.
SSH=jean-zay-auto   # ~/.ssh/config: through gansas, else through CC then gansas
SCHED=slurm
CLONE=/lustre/fswork/projects/rech/iwy/uzu97zj/iris/LIONS-simulation
CONTAINER=singularity
CONTAINER_SETUP='module load singularity/3.8.5; export SINGULARITY_CACHEDIR=/lustre/fsn1/projects/rech/iwy/uzu97zj/.singularity'
IMAGE_DIR=/lustre/fsn1/singularity/images/uzu97zj
IMAGE_STAGE=/lustre/fsstor/projects/rech/iwy/uzu97zj/iris/images
IMAGE_INSTALL='idrcontmgr cp'
# The login nodes kill the squashfs step of a pull: the image is copied from CC, then installed.
IMAGE_FROM=cc
COMPUTE_ONLY_RUNTIME=1
# Results on WORK: STORE is not mounted on the compute nodes.
XSH_RESULTS=/lustre/fswork/projects/rech/iwy/uzu97zj/iris/results
SLURM_OPTS_prod='--account=iwy@cpu --partition=cpu_p1 --qos=qos_cpu-t3 --hint=nomultithread'
SLURM_OPTS_test='--account=iwy@cpu --partition=cpu_p1 --qos=qos_cpu-dev --hint=nomultithread'
# A100: the image's torch (CUDA 13) has no kernels for V100 (sm_70). Allocation 15000 h A100 (2026-2027).
SLURM_OPTS_gpu='--account=iwy@a100 -C a100 --gres=gpu:1 --qos=qos_gpu_a100-dev --hint=nomultithread'
SLURM_NO_MEM=1
